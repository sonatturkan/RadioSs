# RadioS distribution: verified package stage, NSIS installer and portable ZIP (Windows only).
#
#   include(RadioSInstaller)   # after include(RadioSRuntime), at the end of CMakeLists.txt
#
# Targets (all require a Release configuration):
#   radios_package_stage  fresh RADIOS_PACKAGE_STAGE from the install components runtime + python +
#                         application (+ symbols into a separate tree), optional Authenticode signing
#                         of RadioS.exe, licence texts, full verification and the exact NSIS file lists
#                         (packaging/windows/cmake/finalize-package-stage.cmake)
#   radios_installer      dist/RadioS-<version>-windows-x64-setup.exe (+ .sha256) from
#                         packaging/windows/radios.nsi with the pinned MSYS2 makensis (NSIS 3.13)
#   radios_portable       dist/RadioS-<version>-windows-x64.zip (+ .sha256), deterministic
#                         (packaging/windows/make_portable_zip.py)
# The installer and the ZIP are built from the same verified stage; the ZIP is the
# byte-reproducible artifact, the NSIS output is not.

include_guard(GLOBAL)
include(RadioSRuntime)

set(RADIOS_PACKAGE_STAGE "${CMAKE_BINARY_DIR}/stage/RadioS" CACHE PATH
    "Paket aşaması (kısa ASCII yol) / package stage (short ASCII path)")
set(RADIOS_DIST_DIR "${CMAKE_SOURCE_DIR}/dist" CACHE PATH "Kurulum/ZIP çıktı klasörü / installer and ZIP output")
set(RADIOS_MSYS2_LOCK_POLICY "REQUIRE" CACHE STRING
    "MSYS2 paketleri kilitten farklıysa / when MSYS2 differs from packaging/windows/msys2-packages.lock: REQUIRE = paket üretme / refuse to package, WARN = yalnız uyar / warn only (geliştirme / development)")
set_property(CACHE RADIOS_MSYS2_LOCK_POLICY PROPERTY STRINGS REQUIRE WARN)
if(NOT RADIOS_MSYS2_LOCK_POLICY MATCHES "^(REQUIRE|WARN)$")
    message(FATAL_ERROR "RADIOS_MSYS2_LOCK_POLICY REQUIRE ya da WARN olmalı / must be REQUIRE or WARN "
                        "(bulunan / found: '${RADIOS_MSYS2_LOCK_POLICY}')")
endif()
set(RADIOS_SIGN_COMMAND "" CACHE STRING
    "İsteğe bağlı imza komutu, dosya yolu sona eklenir / optional signing command, the file path is appended (e.g. signtool sign /fd sha256 /a /tr http://timestamp.digicert.com /td sha256)")

if(RADIOS_PACKAGE_STAGE MATCHES "[^ -~]" OR RADIOS_PACKAGE_STAGE MATCHES " ")
    message(FATAL_ERROR "RADIOS_PACKAGE_STAGE boşluksuz ASCII olmalı / must be ASCII without spaces "
                        "(binutils/NSIS tools, MAX_PATH): ${RADIOS_PACKAGE_STAGE}")
endif()
string(LENGTH "${RADIOS_PACKAGE_STAGE}" _radios_stage_length)
if(_radios_stage_length GREATER 100)
    message(FATAL_ERROR "RADIOS_PACKAGE_STAGE çok uzun (${_radios_stage_length} > 100) / too long for the MAX_PATH "
                        "budget: ${RADIOS_PACKAGE_STAGE}")
endif()
unset(_radios_stage_length)

set(RADIOS_SYMBOLS_STAGE "${RADIOS_PACKAGE_STAGE}-symbols")
set(_radios_pkg_dir "${CMAKE_BINARY_DIR}/packaging")
set(_radios_pkg_config "${_radios_pkg_dir}/package-config.cmake")
set(_radios_version_quad "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}.0")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\." _ "${RADIOS_PYTHON_VERSION}")
set(_radios_python_abi "${CMAKE_MATCH_1}${CMAKE_MATCH_2}")
if(RADIOS_FFMPEG_PREFIX)
    set(_radios_ffmpeg_note "LGPL build from ${RADIOS_FFMPEG_PREFIX} (packaging/windows/build-ffmpeg.ps1)")
else()
    set(_radios_ffmpeg_note "not bundled")
endif()
file(MAKE_DIRECTORY "${_radios_pkg_dir}")
file(WRITE "${_radios_pkg_config}" "# Generated by cmake/RadioSInstaller.cmake - do not edit.
set(RADIOS_VERSION [==[${PROJECT_VERSION}]==])
set(RADIOS_STAGE [==[${RADIOS_PACKAGE_STAGE}]==])
set(RADIOS_SYMBOLS_STAGE [==[${RADIOS_SYMBOLS_STAGE}]==])
set(RADIOS_NSIS_DIR [==[${_radios_pkg_dir}/nsis]==])
set(RADIOS_WORK_DIR [==[${_radios_pkg_dir}/work]==])
set(RADIOS_MSYS2_PREFIX [==[${RADIOS_MSYS2_PREFIX}]==])
set(RADIOS_FFMPEG_PREFIX [==[${RADIOS_FFMPEG_PREFIX}]==])
set(RADIOS_FFMPEG_VERSION_NOTE [==[${_radios_ffmpeg_note}]==])
set(RADIOS_OBJDUMP [==[${CMAKE_OBJDUMP}]==])
set(RADIOS_SYSTEM_DLLS [==[${RADIOS_SYSTEM_DLLS}]==])
set(RADIOS_PACKAGE_FORBIDDEN_DLL_REGEX [==[${RADIOS_PACKAGE_FORBIDDEN_DLL_REGEX}]==])
set(RADIOS_ICON_THEMES [==[${RADIOS_ICON_THEMES}]==])
set(RADIOS_LICENSE_RULES [==[${CMAKE_SOURCE_DIR}/packaging/windows/third-party-licenses.txt]==])
set(RADIOS_MSYS2_LOCK [==[${RADIOS_MSYS2_LOCK}]==])
set(RADIOS_TZDATA_WHEEL [==[${RADIOS_TZDATA_WHEEL}]==])
set(RADIOS_PYTHON_ABI [==[${_radios_python_abi}]==])
")
unset(_radios_ffmpeg_note)
unset(_radios_python_abi)

# Signing hooks (D2: sign before hashing/packaging). The NSIS include is always generated so the
# script has a single, explicit source of truth.
set(_radios_sign_nsh "; Generated by cmake/RadioSInstaller.cmake - do not edit.\n")
set(_radios_sign_exe "")
if(RADIOS_SIGN_COMMAND)
    separate_arguments(_radios_sign_exe WINDOWS_COMMAND "${RADIOS_SIGN_COMMAND}")
    string(REPLACE "'" "" _radios_sign_quoted "${RADIOS_SIGN_COMMAND}")
    string(APPEND _radios_sign_nsh "!finalize '${_radios_sign_quoted} \"%1\"' = 0\n"
                                   "!uninstfinalize '${_radios_sign_quoted} \"%1\"' = 0\n")
    unset(_radios_sign_quoted)
endif()
file(WRITE "${_radios_pkg_dir}/nsis-signing.nsh" "${_radios_sign_nsh}")
unset(_radios_sign_nsh)

set(_radios_stage_commands
    COMMAND "${CMAKE_COMMAND}" -DRADIOS_BUILD_TYPE=$<CONFIG> -P "${CMAKE_SOURCE_DIR}/packaging/windows/cmake/require-release.cmake"
    # The bundled DLLs must come from the verified MSYS2 snapshot (rolling distribution).
    COMMAND "${CMAKE_COMMAND}" -DMODE=check "-DPOLICY=${RADIOS_MSYS2_LOCK_POLICY}"
            "-DRADIOS_MSYS2_PREFIX=${RADIOS_MSYS2_PREFIX}" "-DLOCK=${RADIOS_MSYS2_LOCK}"
            -P "${CMAKE_SOURCE_DIR}/packaging/windows/cmake/msys2-lock.cmake"
    COMMAND "${CMAKE_COMMAND}" -E rm -rf "${RADIOS_PACKAGE_STAGE}" "${RADIOS_SYMBOLS_STAGE}" "${_radios_pkg_dir}/nsis"
    COMMAND "${CMAKE_COMMAND}" --install "${CMAKE_BINARY_DIR}" --component runtime --prefix "${RADIOS_PACKAGE_STAGE}"
    COMMAND "${CMAKE_COMMAND}" --install "${CMAKE_BINARY_DIR}" --component python --prefix "${RADIOS_PACKAGE_STAGE}"
    COMMAND "${CMAKE_COMMAND}" --install "${CMAKE_BINARY_DIR}" --component application --prefix "${RADIOS_PACKAGE_STAGE}"
    COMMAND "${CMAKE_COMMAND}" --install "${CMAKE_BINARY_DIR}" --component symbols --prefix "${RADIOS_SYMBOLS_STAGE}")
if(_radios_sign_exe)
    list(APPEND _radios_stage_commands COMMAND ${_radios_sign_exe} "${RADIOS_PACKAGE_STAGE}/bin/RadioS.exe")
endif()
add_custom_target(radios_package_stage
    ${_radios_stage_commands}
    COMMAND "${CMAKE_COMMAND}" "-DRADIOS_PACKAGE_CONFIG=${_radios_pkg_config}"
            -P "${CMAKE_SOURCE_DIR}/packaging/windows/cmake/finalize-package-stage.cmake"
    DEPENDS radios
    COMMENT "RadioS paket aşaması / package stage: ${RADIOS_PACKAGE_STAGE}"
    USES_TERMINAL
    VERBATIM)
unset(_radios_stage_commands)
unset(_radios_sign_exe)

set(_radios_setup "${RADIOS_DIST_DIR}/RadioS-${PROJECT_VERSION}-windows-x64-setup.exe")
set(_radios_zip "${RADIOS_DIST_DIR}/RadioS-${PROJECT_VERSION}-windows-x64.zip")
set(_radios_makensis "${RADIOS_MSYS2_PREFIX}/bin/makensis.exe")
set(_radios_icon_define "")
if(EXISTS "${CMAKE_SOURCE_DIR}/assets/icons/radios.ico")
    set(_radios_icon_define "-DRADIOS_ICON=${CMAKE_SOURCE_DIR}/assets/icons/radios.ico")
else()
    message(STATUS "RadioS: assets/icons/radios.ico yok; kurulum varsayılan NSIS simgesini kullanır / "
                   "missing, the installer uses the default NSIS icon")
endif()
if(EXISTS "${_radios_makensis}")
    add_custom_target(radios_installer
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${RADIOS_DIST_DIR}"
        COMMAND "${CMAKE_COMMAND}" -E rm -f "${_radios_setup}" "${_radios_setup}.sha256"
        # -NOCD: relative File paths of the generated lists resolve against the stage (cwd).
        COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR} "${_radios_makensis}" -NOCD -INPUTCHARSET UTF8 -V2
                "-DRADIOS_VERSION=${PROJECT_VERSION}"
                "-DRADIOS_VERSION_QUAD=${_radios_version_quad}"
                "-DRADIOS_NSIS_DIR=${_radios_pkg_dir}/nsis"
                "-DRADIOS_SIGNING_NSH=${_radios_pkg_dir}/nsis-signing.nsh"
                "-DRADIOS_OUT=${_radios_setup}"
                ${_radios_icon_define}
                "${CMAKE_SOURCE_DIR}/packaging/windows/radios.nsi"
        COMMAND "${CMAKE_COMMAND}" "-DRADIOS_FILE=${_radios_setup}"
                -P "${CMAKE_SOURCE_DIR}/packaging/windows/cmake/write-sha256.cmake"
        WORKING_DIRECTORY "${RADIOS_PACKAGE_STAGE}"
        DEPENDS radios_package_stage
        COMMENT "RadioS kurulum programı / installer: ${_radios_setup}"
        USES_TERMINAL
        VERBATIM)
else()
    message(STATUS "RadioS: ${_radios_makensis} yok; radios_installer hata verecek / missing, radios_installer "
                   "will fail (pacman -S mingw-w64-ucrt-x86_64-nsis)")
    add_custom_target(radios_installer
        COMMAND "${CMAKE_COMMAND}" -E echo "makensis.exe yok / missing: ${_radios_makensis}"
        COMMAND "${CMAKE_COMMAND}" -E false
        VERBATIM)
endif()
add_custom_target(radios_portable
    COMMAND ${RADIOS_PACKAGING_PYTHON} "${CMAKE_SOURCE_DIR}/packaging/windows/make_portable_zip.py"
            --stage "${RADIOS_PACKAGE_STAGE}" --output "${_radios_zip}" --root-name RadioS
    DEPENDS radios_package_stage
    COMMENT "RadioS taşınabilir ZIP / portable ZIP: ${_radios_zip}"
    USES_TERMINAL
    VERBATIM)
unset(_radios_setup)
unset(_radios_zip)
unset(_radios_makensis)
unset(_radios_icon_define)
unset(_radios_version_quad)
unset(_radios_pkg_dir)
unset(_radios_pkg_config)
