# Windows executables: every RadioS program (the application, every test, every tool)
# gets, through one deferred finalize step and without edits to the add_executable()
# calls:
#   - src/app/radios.manifest (activeCodePage UTF-8, PerMonitorV2, longPathAware,
#     asInvoker, Windows 10/11, Common Controls v6) as RT_MANIFEST #1,
#   - the application icon and a VERSIONINFO built from project(VERSION),
#   - src/app/crt_binmode.c (binary CRT default file mode),
#   - an 8 MiB main-thread stack reserve (GLib threads inherit it).
# Only `radios` (OUTPUT_NAME RadioS) is a GUI-subsystem program (WIN32_EXECUTABLE).
include_guard(GLOBAL)

set(RADIOS_ICON_FILE "${CMAKE_SOURCE_DIR}/assets/icons/radios.ico")
set(RADIOS_MANIFEST_FILE "${CMAKE_SOURCE_DIR}/src/app/radios.manifest")
set(RADIOS_STACK_RESERVE 8388608)
foreach(_radios_file IN ITEMS "${RADIOS_ICON_FILE}" "${RADIOS_MANIFEST_FILE}" "${CMAKE_SOURCE_DIR}/src/app/radios.rc")
    if(NOT EXISTS "${_radios_file}")
        message(FATAL_ERROR "${_radios_file} yok (Windows kaynakları).")
    endif()
endforeach()

# Version numbers and resource file paths for src/app/radios.rc (ASCII only; the
# Turkish strings live in radios.rc itself under #pragma code_page(65001)).
set(RADIOS_RESOURCE_DIR "${CMAKE_BINARY_DIR}/win32")
file(CONFIGURE OUTPUT "${RADIOS_RESOURCE_DIR}/radios_resource.h" @ONLY CONTENT [==[
/* Generated by cmake/RadioSWindowsExe.cmake from project(RadioS VERSION ...). */
#define RADIOS_RC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define RADIOS_RC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define RADIOS_RC_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define RADIOS_RC_VERSION_STRING "@PROJECT_VERSION@"
#define RADIOS_RC_ICON_FILE "@RADIOS_ICON_FILE@"
#define RADIOS_RC_MANIFEST_FILE "@RADIOS_MANIFEST_FILE@"
]==])
set_source_files_properties("${CMAKE_SOURCE_DIR}/src/app/radios.rc" PROPERTIES
    OBJECT_DEPENDS "${RADIOS_ICON_FILE};${RADIOS_MANIFEST_FILE};${RADIOS_RESOURCE_DIR}/radios_resource.h")

add_library(radios_exe_common OBJECT src/app/crt_binmode.c)
target_link_libraries(radios_exe_common PRIVATE radios_warnings)
foreach(_radios_kind IN ITEMS app tool)
    add_library(radios_resources_${_radios_kind} OBJECT src/app/radios.rc)
    target_include_directories(radios_resources_${_radios_kind} PRIVATE "${RADIOS_RESOURCE_DIR}")
    target_compile_definitions(radios_resources_${_radios_kind} PRIVATE
        RADIOS_RC_KIND_${_radios_kind} "$<$<CONFIG:Debug>:RADIOS_RC_DEBUG>")
endforeach()

# radios_wrap(<target> <symbol>... [DLLIMPORT <symbol>...])
# GNU ld on PE wraps only references named exactly <symbol>. Functions declared
# __declspec(dllimport) (GLib/GIO/GObject, json-glib, cairo, pango, curl, Win32) are
# referenced as __imp_<symbol>: list them after DLLIMPORT, which wraps that pointer
# too; the test then defines `__wrap___imp_<symbol>` (a pointer to its wrapper).
# A plain wrap of such a symbol would silently not intercept, so it is refused.
set(RADIOS_DLLIMPORT_SYMBOL_REGEX "^(g_|json_|cairo_|pango_|curl_|[A-Z])")
function(radios_wrap target)
    cmake_parse_arguments(PARSE_ARGV 1 _wrap "" "" "DLLIMPORT")
    foreach(_symbol IN LISTS _wrap_UNPARSED_ARGUMENTS)
        if(_symbol MATCHES "${RADIOS_DLLIMPORT_SYMBOL_REGEX}")
            message(FATAL_ERROR "radios_wrap(${target} ${_symbol}): ${_symbol} bir DLL'den __declspec(dllimport) "
                                "ile gelir; düz --wrap PE'de etkisizdir. DLLIMPORT ${_symbol} kullanın veya "
                                "testte makro/işlev göstergesi dikişi kurun.")
        endif()
        target_link_options(${target} PRIVATE "LINKER:--wrap=${_symbol}")
    endforeach()
    foreach(_symbol IN LISTS _wrap_DLLIMPORT)
        target_link_options(${target} PRIVATE "LINKER:--wrap=${_symbol}" "LINKER:--wrap=__imp_${_symbol}")
    endforeach()
endfunction()

# radios_optional_source(<var> <path relative to the source dir>)
# <var> = the absolute path when the file exists, else empty. The check is a
# CONFIGURE_DEPENDS glob, so the build reconfigures by itself when the file appears
# or disappears (sources being added by the parallel porting work).
function(radios_optional_source var relative)
    file(GLOB _found CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${relative}")
    set(${var} "${_found}" PARENT_SCOPE)
endfunction()

# Test-process support provided by the tests area (tests-c.md sections 4.1 and 5):
#   tests/support/radios_test_runtime_win32.c  always linked into every test program
#       (constructor: no WER/abort dialogs, 1 ms timer resolution);
#   tests/radios_test_support.c (+ .h)         helper library for every test program.
radios_optional_source(RADIOS_TEST_RUNTIME_SOURCE tests/support/radios_test_runtime_win32.c)
radios_optional_source(RADIOS_TEST_SUPPORT_SOURCE tests/radios_test_support.c)

function(radios_is_test_executable target out_var)
    get_target_property(_sources ${target} SOURCES)
    set(_result FALSE)
    foreach(_source IN LISTS _sources)
        cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${CMAKE_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE _absolute)
        cmake_path(IS_PREFIX RADIOS_TESTS_DIR "${_absolute}" _inside)
        if(_inside)
            set(_result TRUE)
            break()
        endif()
    endforeach()
    set(${out_var} ${_result} PARENT_SCOPE)
endfunction()
set(RADIOS_TESTS_DIR "${CMAKE_SOURCE_DIR}/tests")

# Every src/**/*.c must belong to a product target (static library or the app):
# a file added by a porting area but not listed in CMake fails the configure.
# Files that are only #include'd into another translation unit are listed here.
set(RADIOS_SOURCES_COMPILED_BY_INCLUSION "")
function(radios_check_source_coverage)
    file(GLOB_RECURSE _all RELATIVE "${CMAKE_SOURCE_DIR}" CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/src/*.c")
    get_property(_targets DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    set(_used ${RADIOS_SOURCES_COMPILED_BY_INCLUSION})
    foreach(_target IN LISTS _targets)
        get_target_property(_type ${_target} TYPE)
        if(NOT (_type STREQUAL "STATIC_LIBRARY" OR _type STREQUAL "OBJECT_LIBRARY" OR _target STREQUAL "radios"))
            continue()
        endif()
        get_target_property(_sources ${_target} SOURCES)
        foreach(_source IN LISTS _sources)
            cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${CMAKE_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE _absolute)
            cmake_path(RELATIVE_PATH _absolute BASE_DIRECTORY "${CMAKE_SOURCE_DIR}" OUTPUT_VARIABLE _relative)
            list(APPEND _used "${_relative}")
        endforeach()
    endforeach()
    set(_missing "")
    foreach(_file IN LISTS _all)
        if(NOT _file IN_LIST _used)
            list(APPEND _missing "${_file}")
        endif()
    endforeach()
    if(_missing)
        list(JOIN _missing "\n  " _text)
        message(FATAL_ERROR "Hiçbir RadioS ürün hedefine eklenmemiş kaynak dosyaları (CMakeLists.txt'ye "
                            "ekleyin):\n  ${_text}")
    endif()
endfunction()

# Runs once, after the whole top-level directory (with every include()d module) has
# been processed, so targets and tests declared anywhere are covered.
function(radios_finalize_targets)
    get_property(_targets DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target IN LISTS _targets)
        get_target_property(_type ${_target} TYPE)
        if(NOT _type STREQUAL "EXECUTABLE")
            continue()
        endif()
        target_link_options(${_target} PRIVATE "LINKER:--stack,${RADIOS_STACK_RESERVE}")
        target_link_libraries(${_target} PRIVATE radios_exe_common)
        if(_target STREQUAL "radios")
            target_link_libraries(${_target} PRIVATE radios_resources_app)
            continue()
        endif()
        target_link_libraries(${_target} PRIVATE radios_resources_tool)
        radios_is_test_executable(${_target} _is_test)
        if(_is_test AND TARGET radios_test_runtime)
            target_link_libraries(${_target} PRIVATE radios_test_runtime)
        endif()
        if(_is_test AND TARGET radios_test_support)
            target_link_libraries(${_target} PRIVATE radios_test_support)
        endif()
    endforeach()
    radios_check_source_coverage()
    if(COMMAND radios_finalize_tests)
        radios_finalize_tests()
    endif()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL radios_finalize_targets)

# Build self-check (CTest `exe_manifest`): a program built exactly like every test and
# tool proves at run time that the manifest is embedded and effective (ANSI code page
# 65001, UTF-8 argv, PerMonitorV2), that the manifest resource is the only one and
# carries the SMI namespaces, longPathAware and asInvoker, that VERSIONINFO and the
# icon are present, that the CRT default file mode is binary and that the stack
# reserve is 8 MiB. `exe_pe_*` read the PE headers with objdump (subsystem, stack,
# ASLR/NX/high-entropy VA).
set(RADIOS_SELFCHECK_ARGUMENT "Türkçe ğüşiöç İı")
function(radios_add_executable_selfcheck)
    file(CONFIGURE OUTPUT "${RADIOS_RESOURCE_DIR}/radios_exe_selfcheck.c" @ONLY CONTENT [==[
/* Generated by cmake/RadioSWindowsExe.cmake (CTest exe_manifest). */
#include <windows.h>
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <wchar.h>

static int failures;

static void check(int ok, const char *what)
{
    printf("%s %s\n", ok ? "ok  " : "FAIL", what);
    if (!ok) failures++;
}

static BOOL CALLBACK count_manifest(HMODULE module, LPCWSTR type, LPWSTR name, LONG_PTR data)
{
    (void)module; (void)type;
    LONG *count = (LONG *)data;
    count[0]++;
    if (IS_INTRESOURCE(name) && LOWORD((ULONG_PTR)name) == 1) count[1]++;
    return TRUE;
}

static char *manifest_text(void)
{
    HRSRC info = FindResourceW(NULL, MAKEINTRESOURCEW(1), MAKEINTRESOURCEW(24) /* RT_MANIFEST */);
    if (!info) return NULL;
    HGLOBAL handle = LoadResource(NULL, info);
    DWORD size = SizeofResource(NULL, info);
    const void *data = handle ? LockResource(handle) : NULL;
    if (!data || !size) return NULL;
    char *text = calloc((size_t)size + 1, 1);
    if (text) memcpy(text, data, size);
    return text;
}

static int binary_fopen(void)
{
    wchar_t directory[MAX_PATH], path[MAX_PATH];
    if (!GetTempPathW(MAX_PATH, directory) || !GetTempFileNameW(directory, L"rds", 0, path)) return 0;
    FILE *file = _wfopen(path, L"w");
    long size = -1;
    if (file) {
        fputs("a\nb", file);
        fclose(file);
        file = _wfopen(path, L"rb");
        if (file) {
            fseek(file, 0, SEEK_END);
            size = ftell(file);
            fclose(file);
        }
    }
    DeleteFileW(path);
    return size == 3;
}

static int version_resource(void)
{
    wchar_t self[MAX_PATH];
    DWORD length = GetModuleFileNameW(NULL, self, MAX_PATH), unused = 0;
    if (!length || length >= MAX_PATH) return 0;
    DWORD size = GetFileVersionInfoSizeW(self, &unused);
    void *block = size ? malloc(size) : NULL;
    int ok = block && GetFileVersionInfoW(self, 0, size, block);
    VS_FIXEDFILEINFO *fixed = NULL;
    UINT fixed_size = 0;
    wchar_t *product = NULL, *description = NULL;
    UINT text_size = 0;
    ok = ok && VerQueryValueW(block, L"\\", (void **)&fixed, &fixed_size) && fixed
         && fixed->dwFileVersionMS == MAKELONG(@PROJECT_VERSION_MINOR@, @PROJECT_VERSION_MAJOR@)
         && fixed->dwFileVersionLS == MAKELONG(0, @PROJECT_VERSION_PATCH@)
         && fixed->dwFileType == VFT_APP;
    ok = ok && VerQueryValueW(block, L"\\StringFileInfo\\041F04B0\\ProductName", (void **)&product, &text_size)
         && wcscmp(product, L"RadioS") == 0;
    ok = ok && VerQueryValueW(block, L"\\StringFileInfo\\041F04B0\\FileDescription", (void **)&description, &text_size)
         && wcscmp(description, L"RadioS test ve araç programı") == 0;
    free(block);
    return ok;
}

int main(int argc, char **argv)
{
    check(GetACP() == 65001, "GetACP() == 65001 (activeCodePage UTF-8 from the manifest)");
    check(argc == 2 && strcmp(argv[1], "@RADIOS_SELFCHECK_ARGUMENT@") == 0, "argv[1] arrives as UTF-8");

    char *manifest = manifest_text();
    check(manifest != NULL, "RT_MANIFEST #1 present");
    if (manifest) {
        check(strstr(manifest, "http://schemas.microsoft.com/SMI/2019/WindowsSettings") != NULL
              && strstr(manifest, "<activeCodePage>UTF-8</activeCodePage>") != NULL, "manifest: activeCodePage UTF-8 (SMI/2019)");
        check(strstr(manifest, "http://schemas.microsoft.com/SMI/2016/WindowsSettings") != NULL
              && strstr(manifest, "<longPathAware>true</longPathAware>") != NULL, "manifest: longPathAware (SMI/2016)");
        check(strstr(manifest, "<dpiAwareness>PerMonitorV2") != NULL
              && strstr(manifest, "http://schemas.microsoft.com/SMI/2005/WindowsSettings") != NULL, "manifest: PerMonitorV2 + dpiAware fallback");
        check(strstr(manifest, "level=\"asInvoker\"") != NULL, "manifest: asInvoker");
        check(strstr(manifest, "{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}") != NULL, "manifest: supportedOS Windows 10/11");
        check(strstr(manifest, "Microsoft.Windows.Common-Controls") != NULL, "manifest: Common Controls v6");
        free(manifest);
    }
    LONG manifests[2] = { 0, 0 };
    EnumResourceNamesW(NULL, MAKEINTRESOURCEW(24), count_manifest, (LONG_PTR)manifests);
    check(manifests[0] == 1 && manifests[1] == 1, "exactly one RT_MANIFEST (ours replaced default-manifest.o)");

    DPI_AWARENESS_CONTEXT context = GetThreadDpiAwarenessContext();
    check(AreDpiAwarenessContextsEqual(context, DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2),
          "DPI awareness is PerMonitorV2");
    typedef BOOLEAN (WINAPI *LongPathsEnabled)(void);
    LongPathsEnabled long_paths = (LongPathsEnabled)(void (*)(void))GetProcAddress(GetModuleHandleW(L"ntdll.dll"),
                                                                                  "RtlAreLongPathsEnabled");
    printf("info RtlAreLongPathsEnabled() = %d (needs the LongPathsEnabled system policy too)\n",
           long_paths ? (int)long_paths() : -1);

    int mode = 0;
    check(_get_fmode(&mode) == 0 && mode == _O_BINARY, "CRT default file mode is _O_BINARY");
    check(binary_fopen(), "fopen(\"w\") writes \"a\\nb\" as 3 bytes");

    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)GetModuleHandleW(NULL);
    const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)((const char *)dos + dos->e_lfanew);
    check(nt->OptionalHeader.SizeOfStackReserve == @RADIOS_STACK_RESERVE@, "stack reserve 8 MiB");
    check(nt->OptionalHeader.Subsystem == IMAGE_SUBSYSTEM_WINDOWS_CUI, "console subsystem (tests/tools)");

    check(FindResourceW(NULL, MAKEINTRESOURCEW(1), MAKEINTRESOURCEW(14) /* RT_GROUP_ICON */) != NULL, "icon group #1");
    check(version_resource(), "VERSIONINFO @PROJECT_VERSION@, ProductName, Turkish FileDescription");
    printf("%s\n", failures ? "exe_manifest: FAILED" : "exe_manifest: all checks passed");
    return failures ? 1 : 0;
}
]==])
    add_executable(radios_exe_selfcheck "${RADIOS_RESOURCE_DIR}/radios_exe_selfcheck.c")
    target_link_libraries(radios_exe_selfcheck PRIVATE version radios_warnings)
    add_test(NAME exe_manifest COMMAND radios_exe_selfcheck "${RADIOS_SELFCHECK_ARGUMENT}")
    set_tests_properties(exe_manifest PROPERTIES TIMEOUT 30)
    if(NOT CMAKE_OBJDUMP OR NOT EXISTS "${CMAKE_OBJDUMP}")
        message(FATAL_ERROR "objdump bulunamadı (CMAKE_OBJDUMP='${CMAKE_OBJDUMP}'); binutils gerekir.")
    endif()
    foreach(_check IN ITEMS "selfcheck|radios_exe_selfcheck|3" "radios|radios|2")
        string(REPLACE "|" ";" _check "${_check}")
        list(GET _check 0 _name)
        list(GET _check 1 _target)
        list(GET _check 2 _subsystem)
        add_test(NAME exe_pe_${_name}
                 COMMAND "${CMAKE_COMMAND}" "-DOBJDUMP=${CMAKE_OBJDUMP}" "-DEXE=$<TARGET_FILE:${_target}>"
                         "-DSUBSYSTEM=${_subsystem}" "-DSTACK_RESERVE=${RADIOS_STACK_RESERVE}"
                         -P "${CMAKE_SOURCE_DIR}/cmake/RadioSCheckPe.cmake")
        set_tests_properties(exe_pe_${_name} PROPERTIES TIMEOUT 30)
    endforeach()
endfunction()
