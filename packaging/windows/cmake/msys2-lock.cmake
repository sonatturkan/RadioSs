# RadioS - MSYS2 UCRT64 package snapshot (packaging/windows/msys2-packages.lock).
#
# The lock names every MSYS2 package (toolchain, GTK stack, bundled DLLs) with the version the
# Windows build and the runtime bundle were verified with. MSYS2 is a rolling distribution: a
# "pacman -Syu" silently changes compilers and the DLLs that end up in the installer, so the
# release pipeline compares the lock with the pacman database of the build machine
# (<RADIOS_MSYS2_PREFIX>/../var/lib/pacman/local).
#
# include():   radios_msys2_lock_check(<lock> <msys2 prefix> <status-var> <report-var>)
#              <status-var>: OK, MISMATCH (report lists every difference) or UNVERIFIABLE
#              (no pacman database, e.g. a cross build; report says why)
# cmake -P:    cmake -DMODE=check|update -DRADIOS_MSYS2_PREFIX=<prefix> [-DLOCK=<file>] [-DPOLICY=REQUIRE|WARN]
#                    -P msys2-lock.cmake
#              check  - exit code 0 only when the installed packages match the lock
#                       (POLICY=WARN: report a mismatch or an unverifiable snapshot as a
#                       warning and exit 0 - development builds only)
#              update - rewrite the lock with the installed versions of the locked packages
#                       (the package-file SHA-256 is kept when the version did not change,
#                       otherwise "-"); packages that are no longer installed are dropped

function(radios_msys2_lock_read lock out_header out_names)
    if(NOT EXISTS "${lock}")
        message(FATAL_ERROR "MSYS2 paket kilidi yok / package lock missing: ${lock}")
    endif()
    file(STRINGS "${lock}" lines ENCODING UTF-8)
    set(header "")
    set(names "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^#" OR line STREQUAL "")
            string(APPEND header "${line}\n")
            continue()
        endif()
        if(NOT line MATCHES "^([A-Za-z0-9@._+-]+) ([^ ]+) ([0-9a-f]+|-)$")
            message(FATAL_ERROR "${lock}: hatalı satır / malformed line: '${line}'")
        endif()
        set(name "${CMAKE_MATCH_1}")
        if(name IN_LIST names)
            message(FATAL_ERROR "${lock}: ${name} iki kez / listed twice")
        endif()
        list(APPEND names "${name}")
        set(_radios_lock_version_${name} "${CMAKE_MATCH_2}" PARENT_SCOPE)
        set(_radios_lock_sha_${name} "${CMAKE_MATCH_3}" PARENT_SCOPE)
    endforeach()
    set(${out_header} "${header}" PARENT_SCOPE)
    set(${out_names} "${names}" PARENT_SCOPE)
endfunction()

# Installed version of <name> from the pacman database (empty when not installed). A local
# database entry is the directory "<name>-<pkgver>-<pkgrel>" (pkgver and pkgrel never contain
# '-'); its desc file holds the authoritative %NAME% and %VERSION%.
function(radios_msys2_installed_version db entries name out_var)
    string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" escaped "${name}")
    set(version "")
    foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^${escaped}-[^-]+-[^-]+$")
            continue()
        endif()
        if(NOT EXISTS "${db}/${entry}/desc")
            continue()
        endif()
        file(READ "${db}/${entry}/desc" desc)
        if(desc MATCHES "%NAME%\r?\n([^\r\n]+)" AND CMAKE_MATCH_1 STREQUAL name
           AND desc MATCHES "%VERSION%\r?\n([^\r\n]+)")
            set(version "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    set(${out_var} "${version}" PARENT_SCOPE)
endfunction()

function(radios_msys2_pacman_db prefix out_var)
    cmake_path(SET db NORMALIZE "${prefix}/../var/lib/pacman/local")
    set(${out_var} "${db}" PARENT_SCOPE)
endfunction()

function(radios_msys2_lock_check lock prefix out_status out_report)
    radios_msys2_lock_read("${lock}" header names)
    radios_msys2_pacman_db("${prefix}" db)
    if(NOT IS_DIRECTORY "${db}")
        set(${out_status} "UNVERIFIABLE" PARENT_SCOPE)
        set(${out_report} "pacman veritabanı yok / no pacman database: ${db}" PARENT_SCOPE)
        return()
    endif()
    file(GLOB entries LIST_DIRECTORIES true RELATIVE "${db}" "${db}/*")
    set(report "")
    foreach(name IN LISTS names)
        radios_msys2_installed_version("${db}" "${entries}" "${name}" installed)
        set(locked "${_radios_lock_version_${name}}")
        if(installed STREQUAL "")
            string(APPEND report "\n  ${name}: kilit/locked ${locked}, kurulu değil/not installed")
        elseif(NOT installed STREQUAL locked)
            string(APPEND report "\n  ${name}: kilit/locked ${locked}, kurulu/installed ${installed}")
        endif()
    endforeach()
    if(report STREQUAL "")
        list(LENGTH names count)
        set(${out_status} "OK" PARENT_SCOPE)
        set(${out_report} "${count} paket kilitle aynı / packages match the lock" PARENT_SCOPE)
    else()
        set(${out_status} "MISMATCH" PARENT_SCOPE)
        set(${out_report} "${report}" PARENT_SCOPE)
    endif()
endfunction()

function(radios_msys2_lock_update lock prefix)
    radios_msys2_lock_read("${lock}" header names)
    radios_msys2_pacman_db("${prefix}" db)
    if(NOT IS_DIRECTORY "${db}")
        message(FATAL_ERROR "pacman veritabanı yok / no pacman database: ${db}")
    endif()
    file(GLOB entries LIST_DIRECTORIES true RELATIVE "${db}" "${db}/*")
    set(body "")
    set(changes "")
    foreach(name IN LISTS names)
        radios_msys2_installed_version("${db}" "${entries}" "${name}" installed)
        set(locked "${_radios_lock_version_${name}}")
        if(installed STREQUAL "")
            string(APPEND changes "\n  - ${name} ${locked} (kurulu değil / not installed)")
            continue()
        endif()
        set(sha "${_radios_lock_sha_${name}}")
        if(NOT installed STREQUAL locked)
            set(sha "-")
            string(APPEND changes "\n  ~ ${name} ${locked} -> ${installed}")
        endif()
        string(APPEND body "${name} ${installed} ${sha}\n")
    endforeach()
    file(WRITE "${lock}.tmp" "${header}${body}")
    file(RENAME "${lock}.tmp" "${lock}")
    if(changes STREQUAL "")
        message(STATUS "${lock}: değişiklik yok / unchanged")
    else()
        message(STATUS "${lock} güncellendi / updated:${changes}")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT RADIOS_MSYS2_PREFIX)
        message(FATAL_ERROR "msys2-lock.cmake: -DRADIOS_MSYS2_PREFIX=<MSYS2 UCRT64 prefix> gerekli / required.")
    endif()
    if(NOT LOCK)
        set(LOCK "${CMAKE_CURRENT_LIST_DIR}/../msys2-packages.lock")
    endif()
    if(NOT POLICY)
        set(POLICY "REQUIRE")
    endif()
    if(NOT POLICY MATCHES "^(REQUIRE|WARN)$")
        message(FATAL_ERROR "msys2-lock.cmake: -DPOLICY=REQUIRE|WARN (bulunan / found: '${POLICY}').")
    endif()
    if(MODE STREQUAL "check")
        radios_msys2_lock_check("${LOCK}" "${RADIOS_MSYS2_PREFIX}" status report)
        if(status STREQUAL "OK")
            message(STATUS "MSYS2: ${report}")
        elseif(POLICY STREQUAL "WARN")
            message(WARNING "MSYS2 paket kilidi doğrulanmadı (POLICY=WARN, yalnız geliştirme) / MSYS2 package "
                            "lock not verified (POLICY=WARN, development only): ${status}:${report}")
        else()
            message(FATAL_ERROR "MSYS2 paketleri doğrulanmış kilitten farklı / MSYS2 packages differ from the "
                                "verified lock ${LOCK} (${status}):${report}\n"
                                "Bilerek güncellediyseniz testlerden sonra 'build-windows.cmd -UpdateMsys2Lock' / "
                                "after a deliberate update and a passing test run: 'build-windows.cmd -UpdateMsys2Lock'.")
        endif()
    elseif(MODE STREQUAL "update")
        radios_msys2_lock_update("${LOCK}" "${RADIOS_MSYS2_PREFIX}")
    else()
        message(FATAL_ERROR "msys2-lock.cmake: -DMODE=check|update gerekli / required.")
    endif()
endif()
