# cmake -DOBJDUMP=<objdump> -DEXE=<file.exe> -DSUBSYSTEM=<2|3> -DSTACK_RESERVE=<bytes> -P RadioSCheckPe.cmake
# Reads the PE optional header of a RadioS executable (CTest exe_pe_*): PE32+ x86-64,
# the expected subsystem (2 = Windows GUI for RadioS.exe, 3 = console for tests and
# tools), the 8 MiB stack reserve and DYNAMIC_BASE | HIGH_ENTROPY_VA | NX_COMPAT.
foreach(_input IN ITEMS OBJDUMP EXE SUBSYSTEM STACK_RESERVE)
    if(NOT DEFINED ${_input} OR "${${_input}}" STREQUAL "")
        message(FATAL_ERROR "RadioSCheckPe.cmake: -D${_input}=... eksik.")
    endif()
endforeach()
if(NOT EXISTS "${EXE}")
    message(FATAL_ERROR "${EXE} yok (hedef derlenmemiş).")
endif()
execute_process(COMMAND "${OBJDUMP}" -p "${EXE}" OUTPUT_VARIABLE _headers ERROR_VARIABLE _error
                RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "${OBJDUMP} -p ${EXE}: ${_error}")
endif()

set(_failures 0)
macro(_radios_field name regex)
    if(_headers MATCHES "${regex}")
        set(${name} "${CMAKE_MATCH_1}")
    else()
        message(SEND_ERROR "${EXE}: '${regex}' objdump çıktısında yok.")
        math(EXPR _failures "${_failures} + 1")
        set(${name} "")
    endif()
endmacro()
_radios_field(_format "file format ([a-z0-9-]+)")
_radios_field(_magic "\nMagic[ \t]+([0-9a-fA-F]+)")
_radios_field(_subsystem "\nSubsystem[ \t]+([0-9a-fA-F]+)")
_radios_field(_stack "\nSizeOfStackReserve[ \t]+([0-9a-fA-F]+)")
_radios_field(_dll "\nDllCharacteristics[ \t]+([0-9a-fA-F]+)")

if(NOT _format STREQUAL "pei-x86-64" OR NOT _magic STREQUAL "020b")
    message(SEND_ERROR "${EXE}: PE32+ x86-64 değil (format ${_format}, magic ${_magic}).")
    math(EXPR _failures "${_failures} + 1")
endif()
math(EXPR _subsystem_value "0x${_subsystem}" OUTPUT_FORMAT DECIMAL)
if(NOT _subsystem_value EQUAL SUBSYSTEM)
    message(SEND_ERROR "${EXE}: Subsystem ${_subsystem_value}, beklenen ${SUBSYSTEM}.")
    math(EXPR _failures "${_failures} + 1")
endif()
math(EXPR _stack_value "0x${_stack}" OUTPUT_FORMAT DECIMAL)
if(NOT _stack_value EQUAL STACK_RESERVE)
    message(SEND_ERROR "${EXE}: SizeOfStackReserve ${_stack_value}, beklenen ${STACK_RESERVE}.")
    math(EXPR _failures "${_failures} + 1")
endif()
# IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA 0x20 | DYNAMIC_BASE 0x40 | NX_COMPAT 0x100
math(EXPR _security "0x${_dll} & 0x160" OUTPUT_FORMAT DECIMAL)
if(NOT _security EQUAL 352)
    message(SEND_ERROR "${EXE}: DllCharacteristics 0x${_dll}; ASLR/yüksek entropi/NX eksik.")
    math(EXPR _failures "${_failures} + 1")
endif()
if(_failures)
    message(FATAL_ERROR "${EXE}: ${_failures} PE denetimi başarısız.")
endif()
message(STATUS "${EXE}: PE32+ x86-64, Subsystem ${_subsystem_value}, stack ${_stack_value}, DllCharacteristics 0x${_dll}")
