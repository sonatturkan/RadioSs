    const gint directions[] = { -1, 0, 1, 1, -1 };
    for (guint i = 0; i < G_N_ELEMENTS(nav_labels); ++i) {
        GtkWidget *button = button_new(nav_labels[i], nav_names[i], i < 3 ? G_CALLBACK(navigate) : G_CALLBACK(zoom), view);
