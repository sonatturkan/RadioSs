# cmake -DOBJDUMP=<objdump> -DEXE=<file.exe> -DFORBIDDEN=<name;prefix;...> -P RadioSCheckImports.cmake
# Fails when the program imports a function whose name starts with one of FORBIDDEN
# (e.g. a test whose fake device API must stand in for every real WinMM/CM call).
foreach(_input IN ITEMS OBJDUMP EXE FORBIDDEN)
    if(NOT DEFINED ${_input} OR "${${_input}}" STREQUAL "")
        message(FATAL_ERROR "RadioSCheckImports.cmake: -D${_input}=... eksik.")
    endif()
endforeach()
if(NOT EXISTS "${EXE}")
    message(FATAL_ERROR "${EXE} yok (hedef derlenmemiş).")
endif()
execute_process(COMMAND "${OBJDUMP}" -p "${EXE}" OUTPUT_VARIABLE _headers ERROR_VARIABLE _error
                RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "${OBJDUMP} -p ${EXE}: ${_error}")
endif()
string(FIND "${_headers}" "The Import Tables" _start)
if(_start EQUAL -1)
    message(FATAL_ERROR "${EXE}: objdump çıktısında içe aktarma tablosu yok.")
endif()
string(SUBSTRING "${_headers}" ${_start} -1 _imports)
# Import table lines: "<hint> <name>" grouped under "DLL Name: <dll>".
string(REGEX MATCHALL "\n[ \t]+[0-9a-fA-F]+[ \t]+[A-Za-z_][A-Za-z0-9_@?]*" _entries "${_imports}")
set(_found "")
foreach(_entry IN LISTS _entries)
    string(REGEX REPLACE "^\n[ \t]+[0-9a-fA-F]+[ \t]+" "" _name "${_entry}")
    foreach(_prefix IN LISTS FORBIDDEN)
        string(FIND "${_name}" "${_prefix}" _position)
        if(_position EQUAL 0)
            list(APPEND _found "${_name}")
        endif()
    endforeach()
endforeach()
list(LENGTH _entries _count)
if(_found)
    list(REMOVE_DUPLICATES _found)
    list(JOIN _found ", " _text)
    message(FATAL_ERROR "${EXE} yasak işlevleri içe aktarıyor: ${_text}")
endif()
message(STATUS "${EXE}: ${_count} içe aktarılan işlev; hiçbiri yasak listesinde (${FORBIDDEN}) değil.")
